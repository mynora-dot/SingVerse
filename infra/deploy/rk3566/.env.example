# Set to the NAS LAN IP to allow the existing Go service to connect.
NAS_BIND_IP=127.0.0.1
COMPUTE_CONTAINER_MEMORY_LIMIT=6g
# Only used by optional compose.rknn.yaml; discover actual host device and group.
RKNPU_DEVICE=/dev/dri/renderD129
RKNPU_GID=
RKNPU_CARD_DEVICE=/dev/dri/card0
RKNPU_CARD_GID=
