<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mynora.singverse.media.playbackhistory.PlaybackActivityMapper">
  <insert id="ensureProfile">
    INSERT INTO song_playback_profile(song_id,heat,pinned,pin_revision)
    SELECT #{song},0,0,0 WHERE NOT EXISTS(SELECT 1 FROM song_playback_profile WHERE song_id=#{song})
  </insert>
  <!-- The same per-song write lock is used by pinning and cache deletion claims. -->
  <update id="lockProfile">UPDATE song_playback_profile SET pin_revision=pin_revision WHERE song_id=#{song}</update>
  <select id="profile" resultType="map">SELECT * FROM song_playback_profile WHERE song_id=#{song}</select>
  <select id="currentProfile" resultType="map">
    SELECT * FROM song_playback_profile WHERE song_id=#{song}<if test="mysql"> FOR UPDATE</if>
  </select>
  <update id="updateProfile">
    UPDATE song_playback_profile SET last_played_at=#{lastPlayed},heat=#{heat},heat_updated_at=#{heatAt}
    WHERE song_id=#{song}
  </update>
  <insert id="insertAttempt">
    INSERT INTO playback_attempt(id,client_type,owner_session_id,token_hash,song_id,snapshot_json,event_seq,
      actual_played_ms,elapsed_ms,state,started_at,client_started_at,last_event_at,lease_until)
    VALUES(#{row.id},#{row.client_type},#{row.owner_session_id},#{row.token_hash},#{row.song_id},#{row.snapshot_json},
      -1,0,0,'PREPARING',#{row.started_at},#{row.client_started_at},#{row.last_event_at},#{row.lease_until})
  </insert>
  <select id="attempt" resultType="map">SELECT * FROM playback_attempt WHERE id=#{id}</select>
  <select id="currentAttempt" resultType="map">
    SELECT * FROM playback_attempt WHERE id=#{id}<if test="mysql"> FOR UPDATE</if>
  </select>
  <update id="updateAttempt">
    UPDATE playback_attempt SET event_seq=#{row.event_seq},actual_played_ms=#{row.actual_played_ms},
      elapsed_ms=#{row.elapsed_ms},state=#{row.state},last_event_at=#{row.last_event_at},lease_until=#{row.lease_until},
      started_playing_at=#{row.started_playing_at},history_id=#{row.history_id},effective_at=#{row.effective_at},
      duration_ms=#{row.duration_ms},last_activity_at=#{row.last_activity_at},client_started_at=#{row.client_started_at},
      client_last_activity_at=#{row.client_last_activity_at}
    WHERE id=#{row.id}
  </update>
  <insert id="insertHistory">
    INSERT INTO playback_history(id,song_id,title,artists_json,version_label,source_name,client_type,
      device_name,requested_by,session_id,attempt_id,started_at,played_ms,duration_ms,status,effective_at,heat_applied,activity_prepared,last_activity_at)
    VALUES(#{row.history_id},#{row.song_id},#{row.title},#{row.artists_json},#{row.version_label},#{row.source_name},
      #{row.client_type},#{row.device_name},#{row.requested_by},#{row.owner_session_id},#{row.id},
      #{row.started_playing_at},0,#{row.duration_ms},'PLAYING',NULL,0,1,#{row.started_playing_at})
  </insert>
  <update id="updateHistory">
    UPDATE playback_history SET played_ms=#{row.actual_played_ms},duration_ms=#{row.duration_ms},
      status=#{row.history_status},ended_at=#{row.ended_at},last_activity_at=#{row.last_activity_at},
      heat_applied=CASE WHEN effective_at IS NULL AND #{row.effective_at} IS NOT NULL THEN 0 ELSE heat_applied END,
      effective_at=#{row.effective_at}
    WHERE id=#{row.history_id}
  </update>
  <select id="history" resultType="map">SELECT * FROM playback_history WHERE id=#{id}</select>
  <select id="currentHistory" resultType="map">
    SELECT * FROM playback_history WHERE id=#{id}<if test="mysql"> FOR UPDATE</if>
  </select>
  <!-- The song/effective index restricts a late-event rebuild to this song, in occurrence order. -->
  <select id="appliedHeatTimes" resultType="long">
    SELECT effective_at FROM playback_history WHERE song_id=#{song} AND effective_at IS NOT NULL
      AND client_type&lt;&gt;'ADMIN' AND (heat_applied=1 OR id=#{current}) ORDER BY effective_at<if test="mysql"> FOR UPDATE</if>
  </select>
  <update id="markAggregated">UPDATE playback_history SET heat_applied=1,effective_at=#{effectiveAt} WHERE id=#{id}</update>
  <select id="unpreparedHistory" resultType="map">
    SELECT * FROM playback_history WHERE activity_prepared=0 ORDER BY started_at,id LIMIT #{limit}
  </select>
  <update id="prepareHistory">
    UPDATE playback_history SET activity_prepared=1,effective_at=#{effectiveAt} WHERE id=#{id}
  </update>
  <select id="pendingHistory" resultType="map">
    SELECT * FROM playback_history WHERE heat_applied=0 AND activity_prepared=1
    ORDER BY effective_at,started_at,id LIMIT #{limit}
  </select>
  <select id="expired" resultType="map">
    SELECT * FROM playback_attempt WHERE state IN ('PREPARING','PLAYING','PAUSED','BUFFERING','ERROR')
      AND lease_until &lt;= #{now} ORDER BY lease_until,id LIMIT #{limit}
  </select>
  <select id="aggregationState" resultType="map">SELECT * FROM playback_activity_state WHERE id=1</select>
  <update id="checkpoint">
    UPDATE playback_activity_state SET ready=#{ready},phase=#{phase},cursor_started_at=#{started},cursor_id=#{id} WHERE id=1
  </update>
</mapper>
