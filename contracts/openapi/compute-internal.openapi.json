  "components": {
    "schemas": {
      "Capabilities": {
        "properties": {
          "service": {
            "type": "string",
            "const": "singverse-compute",
            "title": "Service",
            "default": "singverse-compute"
          },
          "apiVersion": {
            "type": "string",
            "const": "1",
            "title": "Apiversion",
            "default": "1"
          },
          "capabilities": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Capabilities"
          }
        },
        "type": "object",
        "title": "Capabilities"
      },
      "ClientInput": {
        "properties": {
          "family": {
            "type": "string",
            "enum": [
              "generic",
              "browser",
              "android",
              "android-tv",
              "fire-tv",
              "ios",
              "ipados",
              "tvos",
              "roku",
              "tizen",
              "webos",
              "kodi",
              "desktop"
            ],
            "title": "Family",
            "default": "generic"
          },
          "containers": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 32,
            "title": "Containers",
            "default": [
              "mp4"
            ]
          },
          "video": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 32,
            "title": "Video",
            "default": [
              "h264"
            ]
          },
          "audio": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 32,
            "title": "Audio",
            "default": [
              "aac"
            ]
          },
          "subtitles": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 32,
            "title": "Subtitles",
            "default": [
              "webvtt"
            ]
          },
          "max_width": {
            "type": "integer",
            "maximum": 16384.0,
            "minimum": 2.0,
            "title": "Max Width",
            "default": 1920
          },
          "max_height": {
            "type": "integer",
            "maximum": 16384.0,
            "minimum": 2.0,
            "title": "Max Height",
            "default": 1080
          },
          "max_fps": {
            "type": "number",
            "maximum": 240.0,
            "minimum": 1.0,
            "title": "Max Fps",
            "default": 30
          },
          "max_bitrate": {
            "type": "integer",
            "maximum": 500000000.0,
            "minimum": 64000.0,
            "title": "Max Bitrate",
            "default": 8000000
          },
          "max_channels": {
            "type": "integer",
            "maximum": 16.0,
            "minimum": 2.0,
            "title": "Max Channels",
            "default": 2
          },
          "max_bit_depth": {
            "type": "integer",
            "maximum": 16.0,
            "minimum": 8.0,
            "title": "Max Bit Depth",
            "default": 8
          },
          "hdr": {
            "type": "boolean",
            "title": "Hdr",
            "default": false
          },
          "hdr_formats": {
            "items": {
              "type": "string",
              "enum": [
                "HDR10",
                "HLG"
              ]
            },
            "type": "array",
            "maxItems": 2,
            "title": "Hdr Formats",
            "default": [
              "HDR10",
              "HLG"
            ]
          },
          "dovi_profiles": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "maxItems": 16,
            "title": "Dovi Profiles"
          },
          "dovi_compatibility": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "maxItems": 16,
            "title": "Dovi Compatibility"
          },
          "hls": {
            "type": "boolean",
            "title": "Hls",
            "default": true
          },
          "fmp4": {
            "type": "boolean",
            "title": "Fmp4",
            "default": false
          },
          "profiles": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": "object",
            "maxProperties": 32,
            "title": "Profiles"
          },
          "levels": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "maxProperties": 32,
            "title": "Levels"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ClientInput"
      },
      "Create": {
        "properties": {
          "path": {
            "anyOf": [
              {
                "type": "string",
