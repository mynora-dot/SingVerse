# Copy to .env, replace placeholders; do not commit .env.
# Docker Compose reads .env. the native Go binary does NOT: export variables explicitly.
SINGVERSE_DB_DRIVER=sqlite
# Native server binds loopback; Docker explicitly binds its private service interface.
SINGVERSE_BIND_ADDRESS=127.0.0.1
SQLITE_PATH=./data/singverse.db
SERVER_PORT=8080
# Docker HTTP entry is served directly by Go (embedded frontend).
IMAGE_PREFIX=ghcr.io/mynora-dot
SINGVERSE_VERSION=latest
COMPOSE_PROFILES=
COMPUTE_RUNTIME=base
SINGVERSE_HTTP_BIND=127.0.0.1
SINGVERSE_HTTP_PORT=18080
# Optional same-stack compute: set COMPOSE_PROFILES=compute AND
# COMPUTE_NODE_URL=http://singverse-compute:8090. Both are empty by default.
# Independent deployment can instead be configured in administrator performance-node settings.
COMPUTE_NODE_URL=
COMPUTE_AUTH_TOKEN_FILE=
# Optional compose.media.yaml: existing absolute host media directory, mounted read-only in Go only.
# WebDAV-only deployments leave this empty and do not apply that override.
SINGVERSE_MEDIA_PATH=
# Standalone infra/docker/compose/compose.compute.yaml: private bind and published port.
COMPUTE_HTTP_BIND=127.0.0.1
COMPUTE_HTTP_PORT=18090
# Separate compute host: business origin reachable FROM compute, no trailing slash.
# Same-stack AUTO deployment already uses its private Compose service address.
SINGVERSE_CALLBACK_ORIGIN=
# LAN discovery pairs from the administrator page without manually copying the connection key.
# Bind the standalone compute HTTP port to its private LAN IP for another machine to discover it.
# First pairing trusts that restricted LAN; subsequent pairing requires the same service identity.
COMPUTE_LAN_PAIRING_ENABLED=true
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=singverse
MYSQL_USER=singverse
MYSQL_PASSWORD=replace_with_local_dev_password
MYSQL_ROOT_PASSWORD=replace_with_local_root_password

# Explicit HTTPS origin (no trailing slash); empty keeps local HTTP testing.
SINGVERSE_PUBLIC_ORIGIN=
# Comma-separated addresses/CIDRs of trusted reverse proxies; empty trusts none.
SINGVERSE_TRUSTED_PROXIES=
# Host Go only: optional master key file; Docker uses its secrets volume.
SINGVERSE_AUTH_KEY_FILE=

# Metadata cover cache only; enable scraping and providers in administrator settings.
METADATA_CACHE_PATH=./data/metadata/covers
# WebDAV embedded cover/lyrics derivatives; keep separate from original media.
# Includes shared assets, export snapshots and unified local/WebDAV STRM/NFO/lyrics under library/.
WEBDAV_METADATA_PATH=./data/metadata/webdav

# Optional administrator-managed TV release directory INSIDE the Go container.
# Copy signed singverse-tv.apk + release.json together to /data/tv-releases, then enable.
SINGVERSE_TV_RELEASE_DIRECTORY=
# Native Go LAN discovery only; leave blank for bridge Docker and advertise on the host.
SINGVERSE_TV_DISCOVERY_ADDRESS=
SINGVERSE_TV_DISCOVERY_PORT=18080

# Optional server-side transcoding; media originals remain read-only.
# Go owns persistent decoded audio/video caches; keep the directory apart from original media.
# Native Go: defaults to TRANSCODE_VERSION_PATH/cache. Compose keeps it in /data/transcoding/cache.
# Initial budget only; administrator cache settings persist in the business database.
# SINGVERSE_SONG_CACHE_PATH=/absolute/path/to/song-cache
# SINGVERSE_SONG_CACHE_BYTES=10737418240
# SINGVERSE_SONG_CACHE_MINIMUM_FREE_BYTES=2147483648
# Compute owns temporary execution outputs only; native nodes need an absolute directory.
# COMPUTE_TRANSCODE_ROOT=/absolute/path/to/transcode-temporary
# COMPUTE_FFMPEG=/absolute/path/to/jellyfin-ffmpeg/ffmpeg
# COMPUTE_FFPROBE=/absolute/path/to/jellyfin-ffmpeg/ffprobe
# COMPUTE_HARDWARE_BACKEND=auto
# COMPUTE_HARDWARE_DEVICE=/dev/dri/renderD128
# COMPUTE_TRANSCODE_CONCURRENCY=1
# COMPUTE_CACHE_BYTES=10737418240
# COMPUTE_MINIMUM_FREE_BYTES=2147483648
# TRANSCODE_VERSION_PATH=/absolute/path/to/compatible-versions
# COMPUTE_RENDER_GID=<host-render-group-id>

# Per-media-process sampled RSS budget; native monitoring, plus Linux container hard limits.
# COMPUTE_PROCESS_MEMORY_BYTES=1073741824
# COMPUTE_CONTAINER_MEMORY_LIMIT=6g
# COMPUTE_CPU_LIMIT=2.0

# Optional offline audio processing (explicit make compute-audio-setup first).
# Native: absolute pinned repository; Compose: bind it read-only using an override.
# Native nodes only; Compose defaults to the model volume, so leave this unset there.
# COMPUTE_AUDIO_MODEL_REPO=/absolute/path/to/.tools/demucs-htdemucs
# COMPUTE_AUDIO_MEMORY_BYTES=4294967296
# COMPUTE_AUDIO_THREADS=0
# 0 自动按有效 CPU 核心、cgroup 配额选择；RK3566 初值最多 2，其他最多 8。
# 原生 Demucs / MDX 常驻进程空闲回收秒数，范围 0～3600；0 关闭旧 Demucs 常驻。
# COMPUTE_AUDIO_WORKER_IDLE_SECONDS=60
# 独立 CPU worker 使用 CPU 专用 ORT；高级档再用 setup-separation-runtime.py --legacy 安装 CPU Torch。
# 原生节点填写项目内绝对路径；容器已配置 /opt/singverse-audio-cpu/bin/python。
# COMPUTE_AUDIO_CPU_PYTHON=/absolute/path/to/services/singverse-compute/.venv-audio-cpu/bin/python
# GPU / Metal 推理环境独立安装；不覆盖 CPU 环境。
# COMPUTE_AUDIO_ACCELERATOR_PYTHON=/absolute/path/to/services/singverse-compute/.venv-audio-mlx/bin/python
# AUDIO_DERIVED_PATH=/absolute/path/to/audio-derivatives
# Docker runtime and hardware mapping are independent; see infra/docker/GPU.md.
# COMPUTE_RUNTIME=base|cpu|uvr|cuda|rocm|rocm-native|openvino|rknn
# COMPUTE_RENDER_GID=<numeric-render-group>
# COMPUTE_VIDEO_GID=<numeric-video-group>
# RKNPU_CARD_GID=<numeric-npu-card-group>
# RKNPU_GID=<numeric-npu-render-group>
# RKNN_MODEL_PATH=/absolute/path/to/verified-rknn-model
# RKNN_RUNTIME_LIBRARY=/usr/lib/librknnrt.so
# SINGVERSE_SOURCE_REVISION=<commit>
# COMPUTE_CONTAINER_MEMORY_LIMIT=6g

# Optional writable NAS directory for compose.downloads.yaml; create it before deployment.
# Originals mounted at /media remain read-only. Container UID/GID 10001 needs write access here.
# SINGVERSE_DOWNLOAD_PATH=/absolute/path/to/downloaded-songs

# Optional diagnostics listener, loopback only; absent from the public router.
# SINGVERSE_DIAGNOSTICS_ADDRESS=127.0.0.1:6060
# DBMATE_BIN=/absolute/path/to/.tools/dbmate
# SINGVERSE_MIGRATIONS_DIR=/absolute/path/to/database/migrations
