# Copy to .env, replace placeholders; do not commit .env.
# Docker Compose reads .env. Spring Boot does NOT: export variables explicitly.
SPRING_PROFILES_ACTIVE=sqlite
SQLITE_PATH=./data/singverse.db
SERVER_PORT=8080
# Docker app entry; backend stays on the private Compose network.
SINGVERSE_HTTP_BIND=127.0.0.1
SINGVERSE_HTTP_PORT=18080
# AUTO mode reads this optional Java -> Python endpoint. App Compose provides it automatically.
# Independent deployment can instead be configured in administrator performance-node settings.
COMPUTE_NODE_URL=
COMPUTE_AUTH_TOKEN_FILE=
# Standalone compose.compute.yaml: existing media directory, private bind and published port.
COMPUTE_MEDIA_PATH=
COMPUTE_HTTP_BIND=127.0.0.1
COMPUTE_HTTP_PORT=18090
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=singverse
MYSQL_USER=singverse
MYSQL_PASSWORD=replace_with_local_dev_password
MYSQL_ROOT_PASSWORD=replace_with_local_root_password

# Explicit HTTPS origin (no trailing slash); empty keeps local HTTP testing.
SINGVERSE_PUBLIC_ORIGIN=
# Comma-separated addresses/CIDRs of trusted reverse proxies; empty trusts none.
SINGVERSE_TRUSTED_PROXIES=
# Host Java only: optional master key file; Docker uses its secrets volume.
SINGVERSE_AUTH_KEY_FILE=

# Metadata cover cache only; enable scraping and providers in administrator settings.
METADATA_CACHE_PATH=./data/metadata/covers
# WebDAV embedded cover/lyrics derivatives; keep separate from original media.
# Includes shared assets, export snapshots and unified local/WebDAV STRM/NFO/lyrics under library/.
WEBDAV_METADATA_PATH=./data/metadata/webdav

# Optional administrator-managed TV release directory INSIDE the Java container.
# Copy signed singverse-tv.apk + release.json together to /data/tv-releases, then enable.
SINGVERSE_TV_RELEASE_DIRECTORY=
# Native Java LAN discovery only; leave blank for bridge Docker and advertise on the host.
SINGVERSE_TV_DISCOVERY_ADDRESS=
SINGVERSE_TV_DISCOVERY_PORT=18080

# Optional server-side transcoding; media originals remain read-only.
# Native nodes need an absolute cache directory. Container defaults are configured in Compose.
# COMPUTE_TRANSCODE_ROOT=/absolute/path/to/transcode-cache
# COMPUTE_JAVA_ORIGIN=http://private-java-host:8080
# COMPUTE_FFMPEG=/absolute/path/to/jellyfin-ffmpeg/ffmpeg
# COMPUTE_FFPROBE=/absolute/path/to/jellyfin-ffmpeg/ffprobe
# COMPUTE_HARDWARE_BACKEND=auto
# COMPUTE_HARDWARE_DEVICE=/dev/dri/renderD128
# COMPUTE_TRANSCODE_CONCURRENCY=1
# COMPUTE_CACHE_BYTES=10737418240
# COMPUTE_MINIMUM_FREE_BYTES=2147483648
# TRANSCODE_VERSION_PATH=/absolute/path/to/compatible-versions
# COMPUTE_RENDER_GID=<host-render-group-id>

# Per-media-process sampled RSS budget; native monitoring, plus Linux container hard limits.
# COMPUTE_PROCESS_MEMORY_BYTES=1073741824
# COMPUTE_CONTAINER_MEMORY_LIMIT=2g
# COMPUTE_CPU_LIMIT=2.0

# Optional offline audio processing (explicit make compute-audio-setup first).
# Native: absolute pinned repository; Compose: bind it read-only using an override.
# Native nodes only; Compose defaults to the model volume, so leave this unset there.
# COMPUTE_AUDIO_MODEL_REPO=/absolute/path/to/.tools/demucs-htdemucs
# COMPUTE_AUDIO_MEMORY_BYTES=4294967296
# COMPUTE_AUDIO_THREADS=2
# AUDIO_DERIVED_PATH=/absolute/path/to/audio-derivatives
# Audio runtime is a Docker target: base/cpu/cuda/rocm/openvino. Prefer matching compose.audio-*.yaml.
# COMPUTE_AUDIO_RUNTIME=cpu
# COMPUTE_IMAGE=ghcr.io/<owner>/singverse-compute:<version>-cpu
# SINGVERSE_VERSION=0.1.0-SNAPSHOT
# SINGVERSE_SOURCE_REVISION=<commit>
# Compose defaults to /var/lib/singverse-models/htdemucs in a writable persistent model volume.
# Device profiles require actual host group IDs. OpenVINO uses COMPUTE_RENDER_GID.
# COMPUTE_RENDER_GID=REPLACE_WITH_HOST_RENDER_GID
# SINGVERSE_RENDER_GID=REPLACE_WITH_HOST_RENDER_GID
# SINGVERSE_VIDEO_GID=REPLACE_WITH_HOST_VIDEO_GID
# COMPUTE_CONTAINER_MEMORY_LIMIT=6g
